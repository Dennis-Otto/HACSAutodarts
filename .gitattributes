# Keep LF line endings in every checkout, including Windows with core.autocrlf.
* text=auto eol=lf

*.png binary
*.webp binary
*.gif binary
*.svg text eol=lf

# Collapse generated lock files in pull request diffs.
requirements-test.txt linguist-generated=true
tests/e2e/requirements-browser.txt linguist-generated=true
package-lock.json linguist-generated=true
